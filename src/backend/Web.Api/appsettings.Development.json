{
  "ConnectionStrings": {
    "Database": "Server=localhost,1433;Database=clean-architecture;User Id=sa;Password=yourStrong(!)Password123;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  // Local authentication stand-in, used only while AzureAd:ClientId above is empty: no tenant, no
  // app registration and no consent needed, so the whole stack boots from one command. Every
  // request is authenticated as the person described here.
  //
  // This bypasses authentication entirely. Startup FAILS if this section is present in any
  // environment other than Development — that is deliberate, not something to work around.
  //
  // Leave "Roles" empty to sign in with every App Role. Set it to [ "Member" ] to see what a
  // non-administrator sees.
  "DevelopmentAuthentication": {
    "ObjectId": "11111111-1111-1111-1111-111111111111",
    "TenantId": "22222222-2222-2222-2222-222222222222",
    "Email": "dev.user@localhost",
    "FirstName": "Dev",
    "LastName": "User",
    "Roles": []
  },

  "Email": {
    "Branding": {
      "AppName": "Aspire Entra ID Template",
      "SupportEmail": "support@example.com",
      "PrimaryColor": "#4f46e5"
    }
  }
}
